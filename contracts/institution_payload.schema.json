{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "金融机构协助查询最小化信息",
  "description": "交给金融机构的信息仅限于完成协助所需内容，不得包含案件脉络、查询目的叙述等内部信息。",
  "type": "object",
  "required": [
    "query_id",
    "notice_no",
    "issuing_authority",
    "legal_basis",
    "account_ids",
    "info_categories",
    "executor_names",
    "valid_until"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "notice_no": {
      "type": "string",
      "minLength": 1
    },
    "issuing_authority": {
      "type": "string",
      "minLength": 1
    },
    "legal_basis": {
      "type": "string",
      "minLength": 1
    },
    "account_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "info_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "executor_names": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
